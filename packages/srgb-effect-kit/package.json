{
  "name": "srgb-effect-kit",
  "version": "0.1.0",
  "description": "Vite plugin and utilities for building SignalRGB effects",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ferretwithaberet/srgb-effect-toolkit.git",
    "directory": "packages/srgb-effect-kit"
  },
  "type": "module",
  "files": [
    "dist",
    "client.d.ts",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "generate:reserved-globals": "node scripts/generate-reserved-globals.ts"
  },
  "peerDependencies": {
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.2",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
